# SlateCamp Vercel beta environment template
# Copy values into Vercel Project Settings → Environment Variables.
# Do not commit real secrets. Keep beta payments disabled.

# Required beta guardrail
NEXT_PUBLIC_PAYMENTS_ENABLED=false
NEXT_PUBLIC_ENABLE_DEMO_MODE=false

# Public Supabase browser variables
# Use the correct Preview or Production project values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase variables
# Never expose service-role keys as NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=

# App/base URLs
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=

# Cron/API protection, if enabled by routes
CRON_SECRET=

# Optional app/runtime AI keys, if the beta environment needs them.
# Keep developer-agent credentials separate from app runtime credentials.
OPENROUTER_API_KEY=

# Explicitly absent for beta launch:
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYREX_SECRET_KEY=
# LEMONSQUEEZY_API_KEY=
