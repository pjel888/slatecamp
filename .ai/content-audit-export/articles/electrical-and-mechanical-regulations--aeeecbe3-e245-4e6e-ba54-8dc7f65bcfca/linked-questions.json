      "correct_value": null,
      "accepted_answers": null,
      "value_tolerance": 0,
      "question_type": "mcq",
      "rationale": "Correct answer: 1.00 m. This is directly supported by PD 1096 2004 Revised IRR, Section 1302.",
      "explanation": "Hoistway pit: ≥600 mm deep. This accommodates the car buffer and maintenance clearance. Compare with: traction elevators = 3 wire ropes minimum; drum elevators = 2 wire ropes minimum — separate rope requirements for the same elevator category.",
      "code_citation": "PD 1096, Rule XIII, Sec. 1302",
