      "topic_id": "078c6572-75b2-47d5-a080-be4d379653d8",
      "text": "Which unit error most commonly breaks the board-foot formula?",
      "options": [
        {
          "id": "a",
          "text": "Using length in inches instead of feet"
        },
        {
          "id": "b",
          "text": "Using width in inches"
        },
        {
          "id": "c",
          "text": "Using thickness in inches"
        },
        {
          "id": "d",
          "text": "Multiplying by the number of pieces"
        }
      ],
      "correct_option_id": "a",
      "correct_value": null,
      "accepted_answers": null,
      "value_tolerance": 0,
      "question_type": "mcq",
      "rationale": "The formula expects thickness and width in inches, but length in feet. Leaving length in inches overstates the answer.",
      "explanation": null,
      "code_citation": "Philippine Lumber Standards (DENR AO 2001-08); NSCP 2015 Section 2401",
