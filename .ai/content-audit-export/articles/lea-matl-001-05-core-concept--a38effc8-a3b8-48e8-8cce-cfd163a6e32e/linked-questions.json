    {
      "question_id": "7eeef6ed-23cf-4ba0-abbf-5acc4b26fc75",
      "article_id": "a38effc8-a3b8-48e8-8cce-cfd163a6e32e",
      "topic_id": "078c6572-75b2-47d5-a080-be4d379653d8",
      "text": "How should an exam item be handled when it gives actual dressed dimensions instead of nominal dimensions?",
      "options": [
        {
          "id": "a",
          "text": "Use the actual dimensions stated in the problem"
        },
        {
          "id": "b",
          "text": "Ignore the actual dimensions and invent nominal dimensions"
        },
        {
          "id": "c",
          "text": "Convert the problem to cubic yards"
        },
        {
          "id": "d",
          "text": "Use mortar-joint thickness instead"
        }
      ],
      "correct_option_id": "a",
      "correct_value": null,
      "accepted_answers": null,
      "value_tolerance": 0,
      "question_type": "mcq",
      "rationale": "Use the dimensions supplied by the item. Actual dimensions are source-safe when the problem gives them explicitly.",
      "explanation": "Moisture content determines if wood is S-Dry or Green, but it is not the basis for Group I-IV classification. Finish is a quality of milling, not botanical grouping. Softwoods like Pine are Group IV; Group I is reserved for high-density hardwoods. Philippine timber is grouped by the Forest Products Research and Development Institute (FPRDI) based on specific gravity. Group I (High Strength) includes Yakal, Molave, and Gijo. Group I = Hardest/Strongest (>0.70 specific gravity). Group IV = Lightest/Weakest (<0.40 specific gravity).",
      "code_citation": "FPRDI Guidelines; NSCP 2015 Table 2401.13-1",
      "bloom_level": "understand",
