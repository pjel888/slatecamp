    },
    {
      "question_id": "9e4aa471-d705-4161-941f-85eb3067c866",
      "article_id": "a38effc8-a3b8-48e8-8cce-cfd163a6e32e",
      "topic_id": "078c6572-75b2-47d5-a080-be4d379653d8",
      "text": "A piece is 2 in x 4 in x 8 ft. How many board feet are in one piece?",
      "options": [
        {
          "id": "a",
          "text": "5.33 board feet"
        },
        {
          "id": "b",
          "text": "2.67 board feet"
        },
        {
          "id": "c",
          "text": "10.67 board feet"
        },
        {
          "id": "d",
          "text": "64 board feet"
        }
      ],
      "correct_option_id": "a",
      "correct_value": null,
      "accepted_answers": null,
      "value_tolerance": 0,
      "question_type": "mcq",
      "rationale": "2 x 4 x 8 / 12 = 5.33 board feet.",
      "explanation": "This is the rough-sawn/nominal size, not the actual finished size. This reduction is insufficient; 0.5 inches is the standard deduction for these sizes. Dimensions decrease during milling and drying, they do not increase. In the Philippines, standard S4S (surfaced 4 sides) lumber reduces nominal dimensions by 0.5 inches for 2-6 inch members. A 2x4 is actually 1.5 x 3.5 inches. Memorize: 1\" nominal becomes 0.75\"; 2\"-6\" nominal reduces by 0.5\"; 8\"+ nominal reduces by 0.75\".",
      "code_citation": "DENR Administrative Order No. 2001-08; NSCP 2015",
      "bloom_level": "understand",
      "application_context": "code_interpretation",
      "practice_context": [],
      "difficulty": 0.3,
      "difficulty_rating": null,
      "discrimination_rating": null,
      "is_assessment": false,
      "model_id": "ALE-MATL-001-05-005",
