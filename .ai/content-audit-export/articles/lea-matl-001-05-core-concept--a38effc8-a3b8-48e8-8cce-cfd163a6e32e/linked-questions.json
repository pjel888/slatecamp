      "correct_value": null,
      "accepted_answers": null,
      "value_tolerance": 0,
      "question_type": "mcq",
      "rationale": "Use the dimensions given: 0.75 x 5.5 x 200 / 12 = 68.75 board feet.",
      "explanation": null,
