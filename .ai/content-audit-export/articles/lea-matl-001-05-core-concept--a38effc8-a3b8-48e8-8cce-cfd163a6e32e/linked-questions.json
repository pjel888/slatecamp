    },
    {
      "question_id": "adec3c12-138b-4db5-bfc4-1003376076f5",
      "article_id": "a38effc8-a3b8-48e8-8cce-cfd163a6e32e",
      "topic_id": "078c6572-75b2-47d5-a080-be4d379653d8",
      "text": "A project needs at least 100 board feet using 2 in x 4 in x 8 ft pieces. How many whole pieces are required?",
      "options": [
        {
          "id": "a",
          "text": "19 pieces"
        },
        {
          "id": "b",
          "text": "18 pieces"
        },
        {
          "id": "c",
          "text": "12 pieces"
        },
        {
          "id": "d",
          "text": "100 pieces"
        }
      ],
      "correct_option_id": "a",
      "correct_value": null,
      "accepted_answers": null,
      "value_tolerance": 0,
      "question_type": "mcq",
      "rationale": "One piece is 5.33 board feet. 100 / 5.33 = 18.75, so 19 whole pieces are required.",
      "explanation": "Incorrect math; likely using incorrect divisors. This would be the result if using ACTUAL dimensions (8.25 BF and 3.5 BF) - however, delivery and trade are measured nominally. Calculation does not result in 450. Using standard NOMINAL board foot calculations for trade: (2×6×12)/12 = 12 BF per pc. 30 pcs × 12 = 360 BF. (2×4×8)/12 = 5.33 BF per pc. 40 pcs × 5.33 = 213.3 BF. Total = 360 + 213.3 = 573.3 BF. This exceeds the 450 BF requirement. Unless specified as 'actual volume', board feet for delivery/invoicing are always based on Nominal dimensions.",
      "code_citation": "NSCP 2015 Section 2401; Material Verification Standards",
      "bloom_level": "apply",
      "application_context": "code_interpretation",
      "practice_context": [],
      "difficulty": 0.7,
      "difficulty_rating": null,
      "discrimination_rating": null,
      "is_assessment": false,
      "model_id": "ALE-MATL-001-05-010",
      "prompt_image_url": null,
      "created_at": "2026-03-23T19:27:27.434371+00:00",
