      "text": "Which dead-end rule is source-safe from the general RA 9514 RIRR egress text?",
      "options": [
        {
          "id": "a",
          "text": "No dead-end pockets, hallways, corridors, passageways, or courts deeper than 6 meters unless an individual occupancy rule modifies the limit."
        },
        {
          "id": "b",
          "text": "Dead ends are unrestricted when the corridor is painted."
        },
        {
          "id": "c",
          "text": "Dead ends may be 30 meters in all buildings."
        },
        {
          "id": "d",
          "text": "Dead ends are checked only after occupancy is granted."
        }
      ],
