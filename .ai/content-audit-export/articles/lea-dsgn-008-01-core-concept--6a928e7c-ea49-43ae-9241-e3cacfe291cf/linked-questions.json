      "topic_id": "ca55b378-141f-4970-8b82-a773aeb0b423",
      "text": "Which definition of means of egress is source-safe from the checked Fire Code source?",
      "options": [
        {
          "id": "a",
          "text": "A continuous and unobstructed route to a public way consisting of exit access, exit, and exit discharge."
        },
        {
          "id": "b",
          "text": "Only the final exterior door of the building."
        },
        {
          "id": "c",
          "text": "Any corridor, even if it ends in a locked room."
        },
        {
          "id": "d",
          "text": "A structural bay used for ventilation."
        }
      ],
      "correct_option_id": "a",
      "correct_value": null,
      "accepted_answers": null,
