  "claims": [
    {
      "claim_id": "ctr021-claim-01",
      "claim_text": "EO 1008 creates CIAC within CIAP and gives it original and exclusive jurisdiction over construction contract disputes when parties agree to arbitration.",
      "claim_type": "legal_or_professional_practice_claim",
      "audit_result": "PASS",
      "source_support": {
        "source_label": "Executive Order No. 1008 - Construction Industry Arbitration Law",
        "locator": "EO 1008 refined markdown lines 23-25",
        "raw_pdf_path": "vitruvius-connection/001_Raw-Source-Layer/001-Laws/EO/EO 1008 Construction Arbitration Law.pdf",
        "raw_pdf_sha256": "sha256:63f4ed2272c98ab63a8dcd491069ee5583534492bbb98a65387ab4efc0c98624",
        "quoted_pdf_excerpt": "CIAC shall have original and exclusive jurisdiction over disputes arising from, or connected with, construction contracts."
      },
      "blockers": []
    },
    {
      "claim_id": "ctr021-claim-02",
      "claim_text": "CIAC jurisdiction covers disputes involving specifications, workmanship, contract terms, damages, delays, defects, payment defaults, and changes in contract cost.",
      "claim_type": "legal_or_professional_practice_claim",
      "audit_result": "PASS",
      "source_support": {
        "source_label": "Executive Order No. 1008 - Construction Industry Arbitration Law",
        "locator": "EO 1008 refined markdown line 27",
        "raw_pdf_path": "vitruvius-connection/001_Raw-Source-Layer/001-Laws/EO/EO 1008 Construction Arbitration Law.pdf",
        "raw_pdf_sha256": "sha256:63f4ed2272c98ab63a8dcd491069ee5583534492bbb98a65387ab4efc0c98624",
        "quoted_pdf_excerpt": "EO 1008 includes disputes on specifications, workmanship, contract terms, damages, penalties, delays, defects, payment default, and changes in contract cost."
      },
      "blockers": []
    },
    {
      "claim_id": "ctr021-claim-03",
      "claim_text": "EO 1008 allows a sole arbitrator or a tribunal of three arbitrators.",
      "claim_type": "legal_or_professional_practice_claim",
      "audit_result": "PASS",
      "source_support": {
        "source_label": "Executive Order No. 1008 - Construction Industry Arbitration Law",
        "locator": "EO 1008 refined markdown lines 57-63",
        "raw_pdf_path": "vitruvius-connection/001_Raw-Source-Layer/001-Laws/EO/EO 1008 Construction Arbitration Law.pdf",
        "raw_pdf_sha256": "sha256:63f4ed2272c98ab63a8dcd491069ee5583534492bbb98a65387ab4efc0c98624",
        "quoted_pdf_excerpt": "Disputes may be heard by a sole arbitrator or by three arbitrators."
      },
      "blockers": []
    },
    {
      "claim_id": "ctr021-claim-04",
      "claim_text": "CIAP Document 102 deems parties to submit connected contract disputes to CIAC.",
      "claim_type": "legal_or_professional_practice_claim",
      "audit_result": "PASS",
      "source_support": {
        "source_label": "CIAP Document 102 - Uniform General Conditions of Contract for Private Construction",
        "locator": "CIAP Document 102 refined markdown line 874",
        "raw_pdf_path": "vitruvius-connection/001_Raw-Source-Layer/001-Laws/CIAP/CIAP-Document-102-Private-Constn-Contract.pdf",
        "raw_pdf_sha256": "sha256:63943bc59465b154329631d2b286706ba45e85c63b31433d1c285d9b7caecd15",
        "quoted_pdf_excerpt": "Entering into the contract is deemed submitting to CIAC jurisdiction for disputes in connection with the contract."
      },
      "blockers": []
    }
  ],
