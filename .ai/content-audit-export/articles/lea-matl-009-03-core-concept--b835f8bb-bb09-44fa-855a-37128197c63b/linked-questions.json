      "topic_id": "a88fd0cc-39e8-4bfb-98a6-ab2367bc10cb",
      "text": "Which professional-practice source names Contract Documentation and Review as a specialized service?",
      "options": [
        {
          "id": "a",
          "text": "UAP SPP 203."
        },
        {
          "id": "b",
          "text": "A paint brochure."
        },
        {
          "id": "c",
          "text": "A land-title form."
