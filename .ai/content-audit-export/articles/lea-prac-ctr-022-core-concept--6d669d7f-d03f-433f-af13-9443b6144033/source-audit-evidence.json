  "claims": [
    {
      "claim_id": "ctr022-claim-01",
      "claim_text": "CIAP Document 102 allows stipulated liquidated damages for failure to complete within the contract time as adjusted.",
      "claim_type": "legal_or_professional_practice_claim",
      "audit_result": "PASS",
      "source_support": {
        "source_label": "CIAP Document 102 - Uniform General Conditions of Contract for Private Construction",
        "locator": "CIAP Document 102 refined markdown lines 591 and 626",
        "raw_pdf_path": "vitruvius-connection/001_Raw-Source-Layer/001-Laws/CIAP/CIAP-Document-102-Private-Constn-Contract.pdf",
        "raw_pdf_sha256": "sha256:63943bc59465b154329631d2b286706ba45e85c63b31433d1c285d9b7caecd15",
        "quoted_pdf_excerpt": "The contractor shall complete within the contract period as adjusted, and failure to complete within the completion time triggers stipulated liquidated damages."
      },
      "blockers": []
    },
    {
      "claim_id": "ctr022-claim-02",
      "claim_text": "CIAP Document 102 states delay liquidated damages accrue from the first day of delay until substantial completion.",
      "claim_type": "legal_or_professional_practice_claim",
      "audit_result": "PASS",
      "source_support": {
        "source_label": "CIAP Document 102 - Uniform General Conditions of Contract for Private Construction",
        "locator": "CIAP Document 102 refined markdown line 626",
        "raw_pdf_path": "vitruvius-connection/001_Raw-Source-Layer/001-Laws/CIAP/CIAP-Document-102-Private-Constn-Contract.pdf",
        "raw_pdf_sha256": "sha256:63943bc59465b154329631d2b286706ba45e85c63b31433d1c285d9b7caecd15",
        "quoted_pdf_excerpt": "Damages accrue from the first day of delay until substantial completion."
      },
      "blockers": []
    },
    {
      "claim_id": "ctr022-claim-03",
      "claim_text": "Substantial completion is tied to 95 percent completion and normal use of the completed portion.",
      "claim_type": "legal_or_professional_practice_claim",
      "audit_result": "PASS",
      "source_support": {
        "source_label": "CIAP Document 102 - Uniform General Conditions of Contract for Private Construction",
        "locator": "CIAP Document 102 refined markdown lines 539-554",
        "raw_pdf_path": "vitruvius-connection/001_Raw-Source-Layer/001-Laws/CIAP/CIAP-Document-102-Private-Constn-Contract.pdf",
