  "sources": [
    {
      "source_id": "01b57866-9d08-48e8-ad05-901cb71f952e",
      "article_id": "4e28889a-cba3-4bf4-805c-ff0526910ee3",
      "label": "The architect typically has authority to approve certain changes within specified limits without owner approval",
      "url": null,
      "source_type": "reference_standard",
      "description": null,
      "is_verified": false,
      "sort_order": 0,
      "created_at": "2026-03-24T04:34:01.68074+00:00",
      "updated_at": "2026-03-24T04:34:01.68074+00:00"
    },
    {
      "source_id": "7ea7b283-1314-4fdd-9840-b36da712dbdc",
      "article_id": "4e28889a-cba3-4bf4-805c-ff0526910ee3",
      "label": "Small changes addressing minor clarifications or deficiency corrections may be within the architect's authority if the contract specifies limits—commonly changes up to 2% to 5% of the contract value",
      "url": null,
      "source_type": "reference_standard",
      "description": "or specified dollar amounts",
      "is_verified": false,
      "sort_order": 1,
      "created_at": "2026-03-24T04:34:01.68074+00:00",
      "updated_at": "2026-03-24T04:34:01.68074+00:00"
    },
    {
      "source_id": "eb021d34-9269-4a83-8075-f7dca9ebda1c",
      "article_id": "4e28889a-cba3-4bf4-805c-ff0526910ee3",
      "label": "The architect's authority to approve changes without owner approval must be explicit in the contract; absent clear authorization, the architect cannot unilaterally commit the owner to additional cost",
      "url": null,
      "source_type": "reference_standard",
      "description": null,
      "is_verified": false,
      "sort_order": 2,
      "created_at": "2026-03-24T04:34:01.68074+00:00",
      "updated_at": "2026-03-24T04:34:01.68074+00:00"
    },
    {
      "source_id": "f02610a1-ec66-4c13-9d80-ba63966fea39",
      "article_id": "4e28889a-cba3-4bf4-805c-ff0526910ee3",
      "label": "Changes exceeding the architect's authority require owner authorization before work proceeds",
      "url": null,
      "source_type": "reference_standard",
      "description": null,
      "is_verified": false,
      "sort_order": 3,
      "created_at": "2026-03-24T04:34:01.68074+00:00",
      "updated_at": "2026-03-24T04:34:01.68074+00:00"
    },
    {
      "source_id": "bfca4dd8-60e7-48c8-9c09-0327028dba98",
      "article_id": "4e28889a-cba3-4bf4-805c-ff0526910ee3",
      "label": "The architect prepares change order documentation with cost estimate and schedule impact analysis, presents this to the owner for approval",
      "url": null,
      "source_type": "reference_standard",
      "description": "and only authorizes contractor work after documented owner approval",
      "is_verified": false,
      "sort_order": 4,
      "created_at": "2026-03-24T04:34:01.68074+00:00",
      "updated_at": "2026-03-24T04:34:01.68074+00:00"
    },
    {
      "source_id": "68c847b2-495c-4911-afa9-40d1372cc2ff",
      "article_id": "4e28889a-cba3-4bf4-805c-ff0526910ee3",
      "label": "Large or expensive changes require detailed architect justification and owner review before authorization",
      "url": null,
      "source_type": "reference_standard",
      "description": null,
      "is_verified": false,
      "sort_order": 5,
      "created_at": "2026-03-24T04:34:01.68074+00:00",
      "updated_at": "2026-03-24T04:34:01.68074+00:00"
    }
  ]
}
