  "proposed": {
    "text": "What distinguishes special permits from temporary permits for foreign architects?",
    "options": [
      {
        "id": "a",
        "text": "Special permits are project-specific; temporary permits are open-ended and valid for any project"
      },
      {
        "id": "b",
        "text": "Temporary permits require endorsement; special permits do not require any professional endorsement"
      },
      {
        "id": "c",
        "text": "Special permits are discretionary based on exceptional expertise; temporary permits are project-specific"
      },
      {
        "id": "d",
        "text": "Special permits are permanent; temporary permits are short-term and expire after the project concludes"
      }
    ],
    "correct_option_id": "c",
    "rationale": {
      "a": "Reverses the scope—temporary permits are project-specific; special permits allow broader consulting work.",
      "b": "Misattributes endorsement—both may require endorsement; the distinction is about expertise level and discretion.",
      "d": "Oversimplifies duration—both are limited-term; the distinction is about approval discretion and scope, not permanence.",
      "correct": "Special permits authorize consulting services requiring exceptional expertise unavailable domestically and are discretionary; temporary permits are project-specific and regularly granted.",
      "takeaway": "Special permits are selective and expertise-based (heritage conservation, complex engineering); temporary permits are routine project authorizations."
    },
