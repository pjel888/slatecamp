    {
      "question_id": "9fc94eab-3953-4408-9461-8fb9442439f2",
      "article_id": "68dc5ecb-7b3f-4394-a7b7-770336b3ce98",
      "topic_id": "fe56dc58-8d23-4769-9c33-40cb187644fb",
      "text": "A 150-unit condominium generates 200 kg/day solid waste and plans segregation per RA 9003 with storage for 3 days. If biodegradable waste is 60%, non-recyclable 25%, recyclable 10%, and hazardous 5%, calculate the storage volume needed for the largest waste stream (assume 0.4 m3/100 kg bulk density).",
      "options": [
        {
          "id": "a",
          "text": "720 L"
        },
        {
          "id": "b",
          "text": "1,440 L"
        },
        {
          "id": "c",
          "text": "3,600 L"
        },
        {
          "id": "d",
          "text": "7,200 L"
        }
      ],
      "correct_option_id": "b",
      "correct_value": null,
      "accepted_answers": null,
      "value_tolerance": 0,
      "question_type": "mcq",
      "rationale": "Largest stream = biodegradable at 60%. Daily biodegradable mass = 200 kg/day x 0.60 = 120 kg/day. 3-day storage = 120 x 3 = 360 kg. Bulk density conversion: 0.4 m3 per 100 kg = 4 L/kg. Volume = 360 kg x 4 L/kg = 1,440 L = 1.44 m3. Correct answer is b (1,440 L). The previously marked answer c (3,600 L) would require 900 kg of biodegradable waste stored, which corresponds to 4.5 days of the full 200 kg/day stream (not the biodegradable fraction) - an arithmetic error. Option a (720 L) would correspond to 180 kg (non-recyclable stream 25% x 200 x 3 = 150 kg x 4 L/kg = 600 L, not 720 L). Option d (7,200 L) corresponds to total unsegregated waste for 3 days plus a factor-of-5 error.",
      "explanation": null,
      "code_citation": "RA 9003 Ecological Solid Waste Management Act, Implementing Rules; local waste generation studies",
      "bloom_level": "apply",
      "application_context": "code_interpretation",
      "practice_context": [],
      "difficulty": 0.5,
      "difficulty_rating": null,
      "discrimination_rating": null,
      "is_assessment": false,
      "model_id": "ALE-UTIL-001-06-008",
      "prompt_image_url": null,
      "created_at": "2026-03-23T19:27:57.369425+00:00",
      "updated_at": "2026-07-20T01:13:22.657055+00:00",
