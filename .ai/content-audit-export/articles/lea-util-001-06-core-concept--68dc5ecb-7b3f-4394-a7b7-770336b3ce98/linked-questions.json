    },
    {
      "question_id": "ee3acf88-d088-4044-9c79-f11577b8162a",
      "article_id": "68dc5ecb-7b3f-4394-a7b7-770336b3ce98",
      "topic_id": "fe56dc58-8d23-4769-9c33-40cb187644fb",
      "text": "A coastal barangay in Quezon province uses a simplified metric: waste generation per capita is 0.4 kg/day (local study). A 1,500-person barangay segregates waste at 60% biodegradable, 25% non-recyclable, 10% recyclable, 5% hazardous. Annual total solid waste is 219 metric tons. The barangay plans composting for biodegradable waste at an efficiency rate (wet-to-finished compost ratio) of 3:1. How many metric tons of finished compost can the barangay produce annually?",
      "options": [
        {
          "id": "a",
          "text": "32.85 metric tons"
        },
        {
          "id": "b",
          "text": "43.8 metric tons"
        },
        {
          "id": "c",
          "text": "65.7 metric tons"
        },
        {
          "id": "d",
          "text": "98.55 metric tons"
        }
      ],
      "correct_option_id": "b",
      "correct_value": null,
      "accepted_answers": null,
      "value_tolerance": 0,
      "question_type": "mcq",
      "rationale": "Annual biodegradable mass = 219 MT x 0.60 = 131.4 MT. A wet-to-finished ratio of 3:1 means 3 units of wet biodegradable input yield 1 unit of finished compost, so finished = 131.4 / 3 = 43.8 MT. Correct answer is b. The previously marked answer a (32.85 MT) results from dividing 131.4 by 4 (a 4:1 ratio), which contradicts the explicitly stated 3:1 ratio in the stem. Option c (65.7 MT) results from multiplying by 0.5 (a 2:1 ratio). Option d (98.55 MT) would be the result of dividing 219 MT total by 3 without segregating to the biodegradable fraction. Cross-check: 1,500 persons x 0.4 kg/day x 365 days = 219,000 kg = 219 MT, matching the stated annual total, so the fraction allocation is internally consistent.",
      "explanation": null,
      "code_citation": "RA 9003 Ecological Solid Waste Management Act; local waste generation studies; composting process yields and Philippine barangay experience",
      "bloom_level": "analyze",
      "application_context": "code_interpretation",
      "practice_context": [],
      "difficulty": 0.5,
      "difficulty_rating": null,
      "discrimination_rating": null,
      "is_assessment": false,
      "model_id": "ALE-UTIL-001-06-025",
