    {
      "question_id": "0f696315-b04f-4279-b9a4-51e25bd4f063",
      "article_id": "39796d5a-c2fd-467f-8891-9e7b32091617",
      "topic_id": "a38bfaba-6196-4148-9533-a12b6170429b",
      "text": "A 200 sq m floor slab is 0.10 m thick. What volume is used before applying the mixture table?",
      "options": [
        {
          "id": "a",
          "text": "20 cu m"
        },
        {
          "id": "b",
          "text": "2 cu m"
        },
        {
          "id": "c",
          "text": "200 cu m"
        },
        {
          "id": "d",
          "text": "0.20 cu m"
        }
      ],
      "correct_option_id": "a",
      "correct_value": null,
      "accepted_answers": null,
      "value_tolerance": 0,
      "question_type": "mcq",
      "rationale": "200 sq m x 0.10 m = 20 cu m.",
      "explanation": "2,000 kg/m³ is close but is used only in fresh (unhardened) concrete estimates, not for cured concrete. 2,200 kg/m³ is below the standard; may confuse with lightweight concrete. 2,600 kg/m³ is for heavyweight concrete, not normal-weight concrete. ACI 211.1 and NSCP 2015 specify 2,400 kg/m³ as the unit weight for normal-weight concrete used in structural applications. Standard unit weight = 2,400 kg/m³. Use this to convert volume (m³) to weight (kg) for transportation and cost calculations.",
      "code_citation": "ACI 211.1-22, NSCP 2015",
      "bloom_level": "remember",
      "application_context": "code_interpretation",
