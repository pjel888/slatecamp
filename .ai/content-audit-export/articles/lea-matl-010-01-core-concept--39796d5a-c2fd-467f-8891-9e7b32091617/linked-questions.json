      "topic_id": "a38bfaba-6196-4148-9533-a12b6170429b",
      "text": "In Fajardo concrete estimating, what is the first quantity to find for a slab by the volume method?",
      "options": [
        {
          "id": "a",
          "text": "Concrete volume in cubic meters"
        },
        {
          "id": "b",
          "text": "Paint liters"
        },
        {
          "id": "c",
          "text": "Number of hollow blocks"
        },
        {
          "id": "d",
          "text": "Board feet"
        }
      ],
      "correct_option_id": "a",
      "correct_value": null,
      "accepted_answers": null,
      "value_tolerance": 0,
      "question_type": "mcq",
      "rationale": "Fajardo starts slab estimating by finding concrete volume.",
      "explanation": "88 kg/m³ results from multiplying 170 × 0.52 instead of dividing. 212 kg/m³ results from an intermediate calculation or estimation error. 408 kg/m³ results from using W/C = 0.42 or other incorrect ratio. Cement = 170 ÷ 0.52 = 326.9 ≈ 327 kg/m³. Always divide water content by the water-cement ratio: Cement = Water ÷ W/C.",
      "code_citation": "ACI 211.1-22",
      "bloom_level": "apply",
      "application_context": "calculation",
      "practice_context": [],
      "difficulty": 0.5,
      "difficulty_rating": null,
