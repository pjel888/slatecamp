    {
      "question_id": "28a96af7-a201-47ff-a1d0-f56bca78c045",
      "article_id": "39796d5a-c2fd-467f-8891-9e7b32091617",
      "topic_id": "a38bfaba-6196-4148-9533-a12b6170429b",
      "text": "Which formula matches the Fajardo slab volume method?",
      "options": [
        {
          "id": "a",
          "text": "Volume = thickness x width x length"
        },
        {
          "id": "b",
          "text": "Volume = perimeter x number of blocks"
        },
        {
          "id": "c",
          "text": "Volume = board feet x 12"
        },
        {
          "id": "d",
          "text": "Volume = tie wire length / 53"
        }
      ],
      "correct_option_id": "a",
      "correct_value": null,
      "accepted_answers": null,
      "value_tolerance": 0,
      "question_type": "mcq",
      "rationale": "The Fajardo examples compute slab volume by thickness times width times length.",
      "explanation": "90 kg/m³ results from multiplying 180 × 0.50 instead of dividing. 180 kg/m³ incorrectly assumes cement content equals water content. 320 kg/m³ results from using W/C = 0.55 (for 20 MPa) instead of 0.50. Cement content = Water content ÷ W/C = 180 ÷ 0.50 = 360 kg/m³. The water-cement ratio is W/C, so Cement = Water ÷ (W/C). For higher strength (lower W/C), cement content increases.",
      "code_citation": "ACI 211.1-22, Mix design methodology",
      "bloom_level": "apply",
      "application_context": "calculation",
      "practice_context": [],
      "difficulty": 0.5,
      "difficulty_rating": null,
      "discrimination_rating": null,
      "is_assessment": false,
