{
  "hooksConfig": {
    "enabled": true
  },
  "context": {
    "includeDirectories": [
      "~/.gemini/extensions/ralph"
    ]
  },
  "hooks": {
    "AfterTool": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "code-review-graph update --skip-flows",
            "timeout": 30000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "code-review-graph status",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
