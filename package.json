    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "openai": "^6.34.0",
    "papaparse": "^5.5.3",
    "payrex-node": "^1.7.3",
    "react": "^19.2.5",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.5",
