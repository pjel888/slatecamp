# Copy to ~/.hermes/.env only when you are ready to add real values.
# Keep this file as an example. Do not put real secrets in shared repos.

# LLM providers
# Preferred Slatecamp developer AI key for Hermes/OpenRouter. Keep real value in ~/.hermes/.env only.
OPENROUTER_API_KEY=
# Legacy/direct-provider fallback keys. Use only when intentionally bypassing OpenRouter.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
KIMI_API_KEY=
ZAI_API_KEY=
MINIMAX_API_KEY=

# Web / research tools
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
BROWSERBASE_API_KEY=

# Messaging gateways
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=

# Optional deployment / repo tools
GITHUB_TOKEN=
VERCEL_TOKEN=
SUPABASE_ACCESS_TOKEN=
